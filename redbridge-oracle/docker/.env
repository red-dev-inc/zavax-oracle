# Copy to .env and edit before `docker compose up -d`.
# Each variable is documented inline below. See ../DEPLOYMENT.md §4.4 for the
# --flag-name -> AVAGO_FLAG_NAME mapping rule and network-switching gotchas.

# Avalanche network to join: fuji (testnet) or mainnet. Also accepts a local/
# custom network ID as a plain integer if you're running your own network.
# The subnet ID and blockchain ID below are network-specific — the defaults
# here are the deployed Fuji values from PROMPT.md and will NOT resolve on
# mainnet.
AVAGO_NETWORK_ID=fuji

# AvalancheGo HTTP RPC port. Bound to 127.0.0.1 only (see docker-compose.yml) —
# put the OpenResty RPC proxy in front of it, don't publish it directly.
AVAGO_HTTP_PORT=9650

# AvalancheGo staking/P2P port. Published on the host's public interface —
# must be reachable from the internet for the node to validate.
AVAGO_STAKING_PORT=9651

# Subnet this node tracks/validates (Fuji redbridge-oracle subnet by default).
AVAGO_TRACK_SUBNETS=EAGjhetxF6gAo3AhYCFuw5e1vJbVY2QMNNHabrubeuBvUjBfj

# Blockchain ID whose VM config.json entrypoint.sh will generate (Fuji
# redbridge-oracle chain by default).
REDBRIDGE_CHAIN_ID=8iARaBqk63EqdbRu7KLu348JkfyFHgw2JkbfsbMWK2r9JE2Dq

# Zcash data source for the VM — REQUIRED. Point this at a synced Zebra node
# with JSON-RPC enabled that is reachable from inside the container. The VM
# re-fetches every Zcash block from it to verify blocks; without it this node
# rejects every redbridge-oracle block and cannot validate. 127.0.0.1 here is
# the container itself, not the host — use the host's IP or host.docker.internal
# (see ../DEPLOYMENT.md §3.3).
ZCASH_RPC_ENDPOINT=http://127.0.0.1:8232
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=
ZCASH_CONFIRMATION_DEPTH=24
